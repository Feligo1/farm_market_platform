# FarmConnect / Supabase PostgreSQL
# Copy this file to backend/.env (do not commit the real .env).
# Supabase dashboard: https://supabase.com/dashboard/project/qlfsmwvehigoildkuevq
# Find or reset your database password in Supabase project settings.
DB_HOST=db.qlfsmwvehigoildkuevq.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require

# Alternatively use DATABASE_URL instead of the DB_* fields above.
# Use Supabase's Session pooler if your hosting provider lacks IPv6.
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require

# Set these to strong distinct random secrets before deployment.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET
DEFAULT_ADMIN_USERNAME=Felix
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
RUN_SCHEDULER=false
RUN_STARTUP_RETRAIN=false
